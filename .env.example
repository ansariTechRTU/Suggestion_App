# ---------------------------------------------------------------- database
# Supabase Postgres. Project → "Connect" button (top right of the dashboard) →
# ORMs / Prisma tab gives you both of these ready-made.
#
# Pooled (pgbouncer, transaction mode, port 6543) — what the running app uses.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Unpooled (session mode, port 5432) — used only by `db push` / `db migrate`,
# which pgbouncer's transaction mode can't run reliably.
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------- server
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000
SESSION_COOKIE_NAME=nk_sid
# openssl rand -hex 32
SESSION_SECRET=replace_me_with_32_bytes_of_hex
UNSUBSCRIBE_SECRET=replace_me_too_with_32_bytes_of_hex

# Serve the built web app from the API process (single-service deployments).
SERVE_WEB=false

# ------------------------------------------------------------------ identity
# Comma-separated. Leave blank to let any Google account sign in — the current
# state, until the organisation's domain is ready to enforce. Once you set
# this, only Workspace accounts on these domains can sign in via Google.
ALLOWED_EMAIL_DOMAINS=

# --------------------------------------------------------------------- email
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
MAIL_FROM="Novikontas Suggestions <suggestions@novikontas.org>"
# https://resend.com/webhooks -> signing secret
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
# Set to true in development to print emails to the console instead of sending
MAIL_DRY_RUN=true

# ----------------------------------------------------------------- schedule
TIMEZONE=Europe/Riga

# ------------------------------------------------------------------ uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880

# ------------------------------------------------------- google sign-in
# The only way into the app — required.
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Authorised redirect URI must be exactly:
#   http://localhost:4000/api/auth/google/callback     (local)
#   https://YOUR-DOMAIN/api/auth/google/callback       (deployed)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional hint that pre-selects a Workspace domain in Google's account
# chooser. Cosmetic only — leave blank while ALLOWED_EMAIL_DOMAINS is blank.
GOOGLE_HOSTED_DOMAIN=
