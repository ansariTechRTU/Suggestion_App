// Novikontas Staff Suggestion Platform — Prisma schema v2
// Adds: weekly cycles, participation/miss ledger, assignment, runtime settings.
//
// Two things Prisma cannot express are created by prisma/raw.sql, which is run
// by `pnpm db:raw` immediately after `db:migrate`:
//   1. suggestions.search_vector  — generated tsvector column + GIN index
//   2. one-suggestion-per-cycle   — partial unique index that ignores WITHDRAWN

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled (pgbouncer, transaction mode) — used by the running app.
  url       = env("DATABASE_URL")
  // Unpooled — used by `db push`/`migrate`, which pgbouncer's transaction
  // mode can't run reliably. Supabase gives you both from its Connect panel.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------- enums

enum Role {
  STAFF
  ADMIN
}

enum Division {
  COLLEGE
  TRAINING_CENTRE
  ENERGY
  SHARED
}

enum Locale {
  EN
  LV
  LT
  RU
  KA
}

enum SuggestionStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  DEFERRED
  IMPLEMENTED
  WITHDRAWN
}

enum CycleStatus {
  OPEN
  GRACE
  CLOSED
}

enum ParticipationStatus {
  PENDING
  SUBMITTED_ON_TIME
  SUBMITTED_IN_GRACE
  MISSED
  EXEMPT
}

enum EmailTemplate {
  FRIDAY_REMINDER
  MONDAY_REMINDER
  STATUS_CHANGED
  RESPONSE_POSTED
  ASSIGNED
}

enum EmailStatus {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  COMPLAINED
  FAILED
}

// ---------------------------------------------------------------- users

model User {
  id          String    @id @default(uuid())
  email       String    @unique
  fullName    String    @map("full_name")
  division    Division  @default(SHARED)
  department  String?
  locale      Locale    @default(EN)
  role        Role      @default(STAFF)
  isActive    Boolean   @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  suggestions      Suggestion[]         @relation("submitter")
  assigned         Suggestion[]         @relation("assignee")
  statusChanges    StatusHistory[]      @relation("changedBy")
  comments         Comment[]
  votes            Vote[]
  emails           EmailLog[]
  sessions         Session[]
  participations   CycleParticipation[]
  auditActions     AuditLog[]           @relation("actor")
  notificationPref NotificationPref?

  @@index([division])
  @@index([isActive])
  @@map("users")
}

model NotificationPref {
  userId               String   @id @map("user_id")
  remindersEnabled     Boolean  @default(true) @map("reminders_enabled")
  statusUpdatesEnabled Boolean  @default(true) @map("status_updates_enabled")
  hardBounced          Boolean  @default(false) @map("hard_bounced")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_prefs")
}

// ---------------------------------------------------------------- auth

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ------------------------------------------------------------ weekly cycle

/// One ISO week. Created by the cycle.open job every Monday 00:05 Europe/Riga.
model WeeklyCycle {
  id          String      @id @default(uuid())
  isoYear     Int         @map("iso_year")
  isoWeek     Int         @map("iso_week")
  /// Monday 00:00 local
  startsAt    DateTime    @map("starts_at")
  /// Sunday 23:59:59 local — the on-time deadline
  endsAt      DateTime    @map("ends_at")
  /// Monday 12:00 local of the following week — the grace deadline
  graceEndsAt DateTime    @map("grace_ends_at")
  status      CycleStatus @default(OPEN)
  closedAt    DateTime?   @map("closed_at")
  createdAt   DateTime    @default(now()) @map("created_at")

  suggestions    Suggestion[]
  participations CycleParticipation[]

  @@unique([isoYear, isoWeek])
  @@index([status])
  @@map("weekly_cycles")
}

/// The miss ledger. One row per active user per cycle, created when the cycle
/// opens, so "who has not submitted yet" is a cheap query rather than a diff.
model CycleParticipation {
  id               String              @id @default(uuid())
  cycleId          String              @map("cycle_id")
  userId           String              @map("user_id")
  status           ParticipationStatus @default(PENDING)
  suggestionId     String?             @unique @map("suggestion_id")
  fridayReminderAt DateTime?           @map("friday_reminder_at")
  mondayReminderAt DateTime?           @map("monday_reminder_at")
  /// Set by an admin when granting an exemption (leave, sick, secondment).
  note             String?
  resolvedById     String?             @map("resolved_by_id")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  cycle      WeeklyCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  suggestion Suggestion? @relation(fields: [suggestionId], references: [id], onDelete: SetNull)

  @@unique([cycleId, userId])
  @@index([userId, status])
  @@index([cycleId, status])
  @@map("cycle_participations")
}

// ---------------------------------------------------------- suggestions

model Category {
  id        String   @id @default(uuid())
  key       String   @unique
  /// { "en": "Equipment", "lv": "Aprīkojums", "ru": "Оборудование" }
  nameI18n  Json     @map("name_i18n")
  division  Division @default(SHARED)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  suggestions Suggestion[]

  @@index([isActive, sortOrder])
  @@map("categories")
}

model Suggestion {
  id            String           @id @default(uuid())
  referenceCode String           @unique @map("reference_code")
  title         String
  body          String
  categoryId    String           @map("category_id")

  /// Always recorded. Stripped by the serialiser when isAnonymous is true.
  submitterId String  @map("submitter_id")
  isAnonymous Boolean @default(false) @map("is_anonymous")

  /// The week this submission satisfies. Null only for withdrawn entries.
  cycleId          String?  @map("cycle_id")
  submittedInGrace Boolean  @default(false) @map("submitted_in_grace")

  status SuggestionStatus @default(SUBMITTED)

  assigneeId String?   @map("assignee_id")
  assignedAt DateTime? @map("assigned_at")
  dueDate    DateTime? @map("due_date")

  responseBody String?   @map("response_body")
  respondedAt  DateTime? @map("responded_at")

  /// Reference of the matching ISO 9001 improvement action.
  qmsActionRef String? @map("qms_action_ref")

  voteCount Int @default(0) @map("vote_count")

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  acknowledgedAt DateTime? @map("acknowledged_at")
  decidedAt      DateTime? @map("decided_at")
  closedAt       DateTime? @map("closed_at")

  /// Generated column, created in prisma/raw.sql
  searchVector Unsupported("tsvector")? @map("search_vector")

  category      Category               @relation(fields: [categoryId], references: [id])
  submitter     User                   @relation("submitter", fields: [submitterId], references: [id])
  assignee      User?                  @relation("assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  cycle         WeeklyCycle?           @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  attachments   SuggestionAttachment[]
  statusHistory StatusHistory[]
  comments      Comment[]
  votes         Vote[]
  participation CycleParticipation?

  @@index([status])
  @@index([categoryId])
  @@index([submitterId])
  @@index([assigneeId])
  @@index([cycleId])
  @@index([createdAt])
  @@map("suggestions")
}

model SuggestionAttachment {
  id           String   @id @default(uuid())
  suggestionId String   @map("suggestion_id")
  fileKey      String   @map("file_key")
  filename     String
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  createdAt    DateTime @default(now()) @map("created_at")

  suggestion Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  @@index([suggestionId])
  @@map("suggestion_attachments")
}

/// Append-only. The ISO 9001 audit trail: never updated, never deleted.
model StatusHistory {
  id           String            @id @default(uuid())
  suggestionId String            @map("suggestion_id")
  fromStatus   SuggestionStatus? @map("from_status")
  toStatus     SuggestionStatus  @map("to_status")
  changedById  String            @map("changed_by_id")
  reason       String?
  changedAt    DateTime          @default(now()) @map("changed_at")

  suggestion Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  changedBy  User       @relation("changedBy", fields: [changedById], references: [id])

  @@index([suggestionId, changedAt])
  @@map("status_history")
}

model Comment {
  id           String   @id @default(uuid())
  suggestionId String   @map("suggestion_id")
  authorId     String   @map("author_id")
  body         String
  /// Admin-only note. Stripped by the serialiser for staff.
  isInternal   Boolean  @default(false) @map("is_internal")
  createdAt    DateTime @default(now()) @map("created_at")

  suggestion Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  author     User       @relation(fields: [authorId], references: [id])

  @@index([suggestionId, createdAt])
  @@map("comments")
}

model Vote {
  suggestionId String   @map("suggestion_id")
  userId       String   @map("user_id")
  createdAt    DateTime @default(now()) @map("created_at")

  suggestion Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([suggestionId, userId])
  @@index([userId])
  @@map("votes")
}

// ------------------------------------------------------------- settings

/// Runtime configuration, editable by admins. Defaults in @nk/shared/settings.
model Setting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// ---------------------------------------------------------------- email

model EmailLog {
  id          String        @id @default(uuid())
  userId      String?       @map("user_id")
  toEmail     String        @map("to_email")
  template    EmailTemplate
  locale      Locale
  resendId    String?       @unique @map("resend_id")
  status      EmailStatus   @default(QUEUED)
  errorText   String?       @map("error_text")
  sentAt      DateTime?     @map("sent_at")
  deliveredAt DateTime?     @map("delivered_at")
  openedAt    DateTime?     @map("opened_at")
  bouncedAt   DateTime?     @map("bounced_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([template, createdAt])
  @@index([status])
  @@map("email_log")
}

model ReminderRun {
  id              String        @id @default(uuid())
  template        EmailTemplate
  cycleId         String?       @map("cycle_id")
  recipientsCount Int           @default(0) @map("recipients_count")
  skippedCount    Int           @default(0) @map("skipped_count")
  failedCount     Int           @default(0) @map("failed_count")
  startedAt       DateTime      @default(now()) @map("started_at")
  finishedAt      DateTime?     @map("finished_at")

  @@index([startedAt])
  @@map("reminder_runs")
}

// ---------------------------------------------------------------- audit

/// Sensitive admin actions — above all, revealing an anonymous submitter.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String   @map("actor_id")
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User @relation("actor", fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}
