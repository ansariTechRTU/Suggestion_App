# ---------------------------------------------------------------- database
# Matches docker-compose.yml. Change the password before any deployment.
DATABASE_URL="postgresql://suggestions:suggestions@localhost:5432/suggestions?schema=public"

# ------------------------------------------------------------------- server
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000
SESSION_COOKIE_NAME=nk_sid
# openssl rand -hex 32
SESSION_SECRET=replace_me_with_32_bytes_of_hex
UNSUBSCRIBE_SECRET=replace_me_too_with_32_bytes_of_hex

# --------------------------------------------------------------- demo mode
# One-click sign-in as any seeded person, no email step. MUST be false in
# production: with it on, anyone who can reach the URL can sign in as an admin.
DEMO_MODE=false
# Serve the built web app from the API process (single-service deployments).
SERVE_WEB=false

# ------------------------------------------------------------------ identity
# Comma-separated. Only these email domains can log in.
ALLOWED_EMAIL_DOMAINS=novikontas.org,novikontas.lv

# --------------------------------------------------------------------- email
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
MAIL_FROM="Novikontas Suggestions <suggestions@novikontas.org>"
# https://resend.com/webhooks -> signing secret
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
# Set to true in development to print emails to the console instead of sending
MAIL_DRY_RUN=true

# ----------------------------------------------------------------- schedule
TIMEZONE=Europe/Riga

# ------------------------------------------------------------------ uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880

# ------------------------------------------------------- google sign-in
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Authorised redirect URI must be exactly:
#   http://localhost:4000/api/auth/google/callback     (local)
#   https://YOUR-DOMAIN/api/auth/google/callback       (deployed)
# Leave both blank to hide the Google button and keep magic links only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Restricts the Google account chooser to your Workspace domain. A hint only —
# the callback re-checks the domain server-side against ALLOWED_EMAIL_DOMAINS.
GOOGLE_HOSTED_DOMAIN=novikontas.org
