# Demo configuration — works as-is, no accounts or keys required.
#   cp .env.demo .env
#
# The two secrets below are throwaway values so the demo starts without setup.
# Replace them before any real deployment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

DATABASE_URL="postgresql://suggestions:suggestions@localhost:5432/suggestions?schema=public"

NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000

SESSION_COOKIE_NAME=nk_sid
SESSION_SECRET=demo_only_2f8c41ab9d6e7350bc12ff94a0d5e6718b3c9a2d4e5f60718293a4b5c6d7e8f9
UNSUBSCRIBE_SECRET=demo_only_9a8b7c6d5e4f30211f2e3d4c5b6a798877665544332211aabbccddeeff00112

# One-click sign-in as any seeded person. Never enable this in production.
DEMO_MODE=true

# Serve the built web app from the API process. Off locally, since Vite does it.
SERVE_WEB=false

ALLOWED_EMAIL_DOMAINS=novikontas.org,novikontas.lv

# No Resend account needed: mail is printed to the API console instead of sent.
MAIL_DRY_RUN=true
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MAIL_FROM="Novikontas Suggestions <suggestions@novikontas.org>"

TIMEZONE=Europe/Riga
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880

# ------------------------------------------------------- google sign-in
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Authorised redirect URI must be exactly:
#   http://localhost:4000/api/auth/google/callback     (local)
#   https://YOUR-DOMAIN/api/auth/google/callback       (deployed)
# Leave both blank to hide the Google button and keep magic links only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Restricts the Google account chooser to your Workspace domain. A hint only —
# the callback re-checks the domain server-side against ALLOWED_EMAIL_DOMAINS.
GOOGLE_HOSTED_DOMAIN=novikontas.org
