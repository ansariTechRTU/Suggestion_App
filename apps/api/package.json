{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/prisma.mjs migrate dev --create-only --name init && node prisma/append-raw.mjs && node scripts/prisma.mjs migrate deploy",
    "db:deploy": "node scripts/prisma.mjs migrate deploy",
    "db:raw": "tsx prisma/apply-raw.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "node scripts/prisma.mjs studio",
    "db:reset": "node scripts/prisma.mjs migrate reset --force",
    "postinstall": "prisma generate",
    "db:migrate:new": "node scripts/prisma.mjs migrate dev",
    "db:push": "tsx prisma/pre-push.ts && node scripts/prisma.mjs db push --skip-generate",
    "db:reseed": "tsx prisma/seed.ts --reseed",
    "release": "prisma generate && tsx prisma/pre-push.ts && node scripts/prisma.mjs db push --accept-data-loss --skip-generate && tsx prisma/apply-raw.ts && tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nk/emails": "workspace:*",
    "@nk/shared": "workspace:*",
    "@prisma/client": "^5.22.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "google-auth-library": "^9.15.0",
    "helmet": "^8.0.0",
    "luxon": "^3.5.0",
    "multer": "^1.4.5-lts.1",
    "pg-boss": "^10.1.5",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^5.22.0",
    "resend": "^4.0.1",
    "svix": "^1.42.0",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/luxon": "^3.4.2",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
